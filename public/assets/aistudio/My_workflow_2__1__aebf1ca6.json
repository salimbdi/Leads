    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst seen = new Set();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n\n  // Skip records without a business name.\n  if (!data.title || !String(data.title).trim()) {\n    continue;\n  }\n\n  // Prefer Google Maps place ID for deduplication.\n  const key = data.place_id\n    ? String(data.place_id).trim().toLowerCase()\n    : `${String(data.title).trim().toLowerCase()}|${String(data.address || '').trim().toLowerCase()}`;\n\n  if (seen.has(key)) {\n    continue;\n  }\n\n  seen.add(key);\n\n  results.push({\n    json: {\n      ...data,\n      website: data.website || '',\n      phone: data.phone || '',\n      address: data.address || '',\n      rating: Number(data.rating || 0),\n      reviews_count: Number(data.reviews_count || 0),\n    }\n  });\n}\n\nreturn results;"
      },
