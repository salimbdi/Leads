    {
      "parameters": {
        "jsCode": "\nconst rawText = $json.content?.parts?.[0]?.text;\n\nif (!rawText) {\n  throw new Error(\"Gemini response text is missing.\");\n}\n\nlet result;\n\ntry {\n  result = JSON.parse(\n    rawText\n      .replace(/^```json\\s*/i, \"\")\n      .replace(/\\s*```$/, \"\")\n      .trim()\n  );\n} catch (error) {\n  throw new Error(\n    `Failed to parse Gemini JSON: ${error.message}`\n  );\n}\n\nconst requiredFields = [\n  \"company_name\",\n  \"personalization_observation\",\n  \"potential_opportunity\",\n  \"icebreaker\"\n];\n\nfor (const field of requiredFields) {\n  if (\n    typeof result[field] !== \"string\" ||\n    !result[field].trim()\n  ) {\n    throw new Error(`Missing or empty AI field: ${field}`);\n  }\n}\n\nreturn {\n  json: {\n    company_name: result.company_name,\n    personalization_observation: result.personalization_observation,\n    potential_opportunity: result.potential_opportunity,\n    icebreaker: result.icebreaker,\n    processing_status: \"completed\"\n  }\n};\n"
      },
