# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
AI_PROVIDER=gemini
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LeadForge Backend & Proxy Configuration
APP_NAME="LeadForge"
APP_ENV="production"
APP_VERSION="0.1.0"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8001"

# Deployed Backend URL (used by Express gateway server and Vite proxy)
# Set to your deployed Render backend:
BACKEND_URL="https://leads-einq.onrender.com"

# Optional client-side API base URL override (leave empty to use same-origin proxy)
VITE_API_BASE_URL=""

# Allowed CORS origins for FastAPI (comma-separated or JSON list)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000"

# Database Configuration (Phase 2)
DATABASE_URL="sqlite:///./leadforge.db"

# AI Provider Configuration ("gemini" for production or "mock" for explicit test mode)
AI_PROVIDER="gemini"
AI_MODEL="gemini-3.1-flash-lite"

APIFY_API_TOKEN=""
# n8n Orchestration Configuration (Phase 4 / Phase 4.6)
# Architecture: LeadForge (Express 3000 / FastAPI Render) <-> Render n8n (https://n8nsalim.onrender.com)
N8N_WEBHOOK_URL="https://n8nsalim.onrender.com/webhook/leadforge"
N8N_CALLBACK_SECRET=""
BACKEND_PUBLIC_URL="https://leads-einq.onrender.com"
N8N_REQUEST_TIMEOUT_SECONDS="15.0"
DEPLOYMENT_MODE="hybrid_cloud"
SQLITE_DURABLE_MOUNT_PATH=""

# Durable Python Background Worker Configuration (Phase 2 / Phase 2.2)
# DISCOVERY_EXECUTION_MODE: "n8n" (default fallback) or "python" (enqueue for Python worker)
# WORKER_ENABLED: "false" (default when running standalone `python -m backend.app.worker`) or "true" (embedded thread)
DISCOVERY_EXECUTION_MODE="n8n"
WORKER_ENABLED="false"
WORKER_POLL_INTERVAL_SECONDS="2.0"
WORKER_MAX_ATTEMPTS="3"
WORKER_STALE_TASK_TIMEOUT_SECONDS="180.0"
WORKER_LEASE_SECONDS="180.0"
WORKER_HEARTBEAT_INTERVAL_SECONDS="15.0"
WORKER_SHUTDOWN_TIMEOUT_SECONDS="30.0"




