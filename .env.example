# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LeadForge Backend Configuration
APP_NAME="LeadForge"
APP_ENV="development"
APP_VERSION="0.1.0"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8001"

# Database Configuration (Phase 2)
DATABASE_URL="sqlite:///./leadforge.db"

# AI Provider Configuration ("mock" for initial development or "gemini" for production)
AI_PROVIDER="mock"
AI_MODEL="gemini-4-carbon"

# n8n Orchestration Configuration (Phase 4 / Phase 4.6)
# Architecture: Local LeadForge (Express 3000 -> FastAPI 8001) <-> Render n8n (https://n8nsalim.onrender.com)
# 1. N8N_WEBHOOK_URL: Set to the active Render n8n production webhook endpoint:
#    N8N_WEBHOOK_URL="https://n8nsalim.onrender.com/webhook/leadforge"
# 2. BACKEND_PUBLIC_URL: Set to your active ngrok HTTPS tunnel forwarding to local port 3000:
#    BACKEND_PUBLIC_URL="https://<your-active-ngrok-subdomain>.ngrok-free.app"
#    (FastAPI automatically appends /api/v1/integrations/n8n/callback)
# 3. N8N_CALLBACK_SECRET: Must match the N8N_CALLBACK_SECRET configured in Render n8n.
N8N_WEBHOOK_URL=""
N8N_CALLBACK_SECRET=""
BACKEND_PUBLIC_URL=""
N8N_REQUEST_TIMEOUT_SECONDS="15.0"
DEPLOYMENT_MODE="local"
SQLITE_DURABLE_MOUNT_PATH=""



